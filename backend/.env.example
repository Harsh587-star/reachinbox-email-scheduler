PORT=5000
NODE_ENV=development
DATABASE_URL="file:./dev.db"

# Redis Config (BullMQ Queue & Rate Limiter)
# Leave empty or set to "memory" if no external Redis is running; our Redis manager automatically falls back to in-memory store
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=

# Elasticsearch Config
# Leave empty if no Elasticsearch is running; our Elasticsearch manager automatically falls back to robust DB search
ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_INDEX=emails

# Scheduler & Worker Settings
WORKER_CONCURRENCY=5
MIN_DELAY_BETWEEN_EMAILS_MS=2000
MAX_EMAILS_PER_HOUR=200

# Auth & Security
JWT_SECRET=reachinbox_super_secret_jwt_key_2026
GOOGLE_CLIENT_ID=mock_or_real_google_client_id.apps.googleusercontent.com

# Frontend URL for CORS
FRONTEND_URL=http://localhost:3000

# Slack Rate-limit Alert Webhook / OAuth
SLACK_WEBHOOK_URL=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:5000/api/slack/callback
